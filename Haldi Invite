
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zoya's Haldi Invitation 🌻</title>

<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background: #fff8cf;
  color: #71400b;
  font-family: 'Cormorant Garamond', serif;
  overflow-x: hidden;
}

.page {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 35px 18px;
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse at center, #fffef0 0%, #fff4b3 65%, #f6d768 100%);
}

.invitation {
  position: relative;
  z-index: 1;
  width: min(100%, 540px);
  padding: 44px 24px;
  text-align: center;
  border: 2px solid #d9a82e;
  outline: 1px solid #d9a82e;
  outline-offset: 7px;
  background: rgba(255, 255, 245, 0.91);
  box-shadow: 0 15px 45px rgba(119, 75, 0, 0.15);
}

.top-flower,
.bottom-flower {
  font-size: 28px;
  letter-spacing: 8px;
}

.bismillah {
  font-size: 29px;
  margin: 20px 0 12px;
  color: #96620c;
  line-height: 1.8;
}

.intro {
  font-family: 'Playfair Display', serif;
  font-size: 12px;
  letter-spacing: 4px;
  text-transform: uppercase;
  margin: 18px 0 12px;
  color: #93651a;
}

h1 {
  font-family: 'Great Vibes', cursive;
  font-size: clamp(48px, 12vw, 76px);
  font-weight: 400;
  color: #c18a13;
  line-height: 1.2;
  margin: 8px 0;
}

.subtitle {
  font-family: 'Playfair Display', serif;
  text-transform: uppercase;
  letter-spacing: 5px;
  font-size: 13px;
  margin: 14px 0 24px;
}

.message {
  font-size: 21px;
  line-height: 1.55;
  margin: 12px auto 22px;
  max-width: 390px;
}

.divider {
  color: #d2a02b;
  margin: 18px auto;
  letter-spacing: 7px;
}

.details {
  font-size: 21px;
  line-height: 1.8;
}

.details strong {
  font-family: 'Playfair Display', serif;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 3px;
  color: #986313;
  display: block;
  margin-top: 12px;
}

.map-link {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 22px;
  border: 1px solid #c99b28;
  color: #7a4c06;
  background: #fff8d9;
  text-decoration: none;
  font-family: 'Playfair Display', serif;
  font-size: 13px;
  letter-spacing: 1px;
  transition: 0.25s;
}

.map-link:hover {
  background: #f4d875;
}

.countdown-title {
  font-family: 'Playfair Display', serif;
  text-transform: uppercase;
  letter-spacing: 3px;
  font-size: 11px;
  margin: 28px 0 12px;
}

.countdown {
  display: flex;
  justify-content: center;
  gap: 12px;
  flex-wrap: wrap;
}

.time-box {
  min-width: 62px;
  padding: 10px 7px;
  background: #fff3bf;
  border: 1px solid #e3c25c;
}

.time-box span {
  display: block;
  font-family: 'Playfair Display', serif;
  font-size: 23px;
}

.time-box small {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.closing {
  font-size: 20px;
  font-style: italic;
  margin-top: 24px;
}

.sunflower {
  position: absolute;
  font-size: 42px;
  opacity: 0.85;
  animation: sway 4s ease-in-out infinite;
  z-index: 0;
}

.flower1 { top: 5%; left: 5%; }
.flower2 { top: 8%; right: 5%; animation-delay: 1s; }
.flower3 { bottom: 5%; left: 6%; animation-delay: 2s; }
.flower4 { bottom: 7%; right: 5%; animation-delay: 0.5s; }

@keyframes sway {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

/* Opening curtains */
.curtain {
  position: fixed;
  top: 0;
  bottom: 0;
  width: 51%;
  z-index: 5;
  background:
    repeating-linear-gradient(
      90deg,
      #b77a12 0px,
      #e4b739 18px,
      #f3d66d 35px,
      #c28a1b 52px
    );
  box-shadow: inset -12px 0 25px rgba(88, 48, 0, 0.2);
  transition: transform 2s cubic-bezier(.65, 0, .35, 1);
}

.curtain::after {
  content: "🌻";
  position: absolute;
  top: 45%;
  font-size: 36px;
}

.curtain.left {
  left: 0;
  border-right: 5px solid #f5d77c;
}

.curtain.left::after { right: 18px; }

.curtain.right {
  right: 0;
  border-left: 5px solid #f5d77c;
}

.curtain.right::after { left: 18px; }

.opening-screen {
  position: fixed;
  inset: 0;
  z-index: 10;
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 25px;
  background: rgba(255, 244, 184, 0.2);
  transition: opacity 0.7s ease;
}

.opening-card {
  padding: 35px 24px;
  width: min(100%, 400px);
  background: rgba(255, 252, 229, 0.96);
  border: 2px solid #d7aa38;
  box-shadow: 0 10px 35px rgba(100, 60, 0, 0.22);
}

.opening-card .small-flower {
  font-size: 38px;
}

.opening-card h2 {
  font-family: 'Great Vibes', cursive;
  font-size: 51px;
  font-weight: 400;
  color: #b77c10;
  margin: 10px 0;
}

.opening-card p {
  font-size: 19px;
  margin: 12px 0 22px;
}

#openButton {
  border: none;
  padding: 14px 25px;
  background: #c38c19;
  color: white;
  font-family: 'Playfair Display', serif;
  font-size: 13px;
  letter-spacing: 2px;
  cursor: pointer;
  transition: 0.2s;
}

#openButton:hover {
  background: #98640d;
  transform: translateY(-2px);
}

body.opened .curtain.left {
  transform: translateX(-100%);
}

body.opened .curtain.right {
  transform: translateX(100%);
}

body.opened .opening-screen {
  opacity: 0;
  pointer-events: none;
}

body.opened .opening-card {
  transform: scale(0.95);
  transition: transform 0.7s ease;
}

@media (max-width: 420px) {
  .invitation { padding: 35px 17px; }
  .message { font-size: 19px; }
  .details { font-size: 19px; }
  .sunflower { font-size: 31px; }
  .bismillah { font-size: 25px; }
}
</style>
</head>

<body>

<div class="sunflower flower1">🌻</div>
<div class="sunflower flower2">🌼</div>
<div class="sunflower flower3">🌻</div>
<div class="sunflower flower4">🌼</div>

<main class="page">
  <section class="invitation">

    <div class="top-flower">🌻 ✨ 🌻</div>

    <div class="bismillah" lang="ar" dir="rtl">
      بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
    </div>

    <p class="intro">With love and happiness</p>

    <p class="message">
      We joyfully invite you to celebrate a beautiful day filled with
      sunshine, laughter, blessings and love.
    </p>

    <div class="divider">✦ ❀ ✦</div>

    <p class="subtitle">Join us for</p>

    <h1>Zoya's Haldi</h1>

    <p class="subtitle">A celebration in yellow</p>

    <div class="divider">🌼 ✧ 🌼</div>

    <div class="details">
      <strong>Date</strong>
      Sunday, 13 December 2026

      <strong>Time</strong>
      8:00 PM

      <strong>Venue</strong>
      Jalsa Banquet Hall
    </div>

    <a
      class="map-link"
      href="https://www.google.com/maps/place/Jalsa+Banquet+Hall/@13.000501,77.6156935,879m/data=!3m2!1e3!4b1!4m6!3m5!1s0x3bae17f048b42b37:0xab845f470c83658a!8m2!3d13.000501!4d77.6156935!16s%2Fg%2F11q867pw36?entry=ttu&g_ep=EgoyMDI2MTAwNy4wIKXMDSoASAFQAw%3D%3D"
      target="_blank"
      rel="noopener noreferrer"
    >
      📍 OPEN MAPS
    </a>

    <p class="countdown-title">Counting down to the celebration</p>

    <div class="countdown" id="countdown" aria-live="polite">
      <div class="time-box"><span id="days">--</span><small>Days</small></div>
      <div class="time-box"><span id="hours">--</span><small>Hours</small></div>
      <div class="time-box"><span id="minutes">--</span><small>Minutes</small></div>
      <div class="time-box"><span id="seconds">--</span><small>Seconds</small></div>
    </div>

    <p class="closing">Your presence will make our celebration even more special. 🤍</p>

    <div class="bottom-flower" style="margin-top:22px;">🌻 🌼 🌻</div>

  </section>
</main>

<!-- Add a file named haldi-music.mp3 to this repository for music -->
<audio id="backgroundMusic" loop preload="auto">
  <source src="haldi-music.mp3" type="audio/mpeg">
</audio>

<div class="curtain left"></div>
<div class="curtain right"></div>

<div class="opening-screen" id="openingScreen">
  <div class="opening-card">
    <div class="small-flower">🌻</div>
    <h2>Zoya's Haldi</h2>
    <p>A little sunshine, a lot of love.<br>Tap to open your invitation</p>
    <button id="openButton" type="button">OPEN INVITATION ✨</button>
  </div>
</div>

<script>
const eventDate = new Date("2026-12-13T20:00:00+05:30").getTime();

function updateCountdown() {
  const now = Date.now();
  const difference = eventDate - now;

  if (difference <= 0) {
    document.getElementById("countdown").innerHTML =
      "<p>The celebration day is here! 🌻</p>";
    return;
  }

  const days = Math.floor(difference / (1000 * 60 * 60 * 24));
  const hours = Math.floor((difference / (1000 * 60 * 60)) % 24);
  const minutes = Math.floor((difference / (1000 * 60)) % 60);
  const seconds = Math.floor((difference / 1000) % 60);

  document.getElementById("days").textContent = days;
  document.getElementById("hours").textContent = hours;
  document.getElementById("minutes").textContent = minutes;
  document.getElementById("seconds").textContent = seconds;
}

updateCountdown();
setInterval(updateCountdown, 1000);

document.getElementById("openButton").addEventListener("click", async function () {
  document.body.classList.add("opened");

  const music = document.getElementById("backgroundMusic");

  try {
    await music.play();
  } catch (error) {
    console.log("Music could not start. Check that haldi-music.mp3 is uploaded.");
  }
});
</script>

</body>
</html>
