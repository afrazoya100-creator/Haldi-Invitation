<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zoya's Haldi Invitation 🌻</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Playfair+Display:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;1,400&display=swap');

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Playfair Display', serif;
  background: #ffdf62;
  color: #80500b;
  text-align: center;
  overflow-x: hidden;
}

.invitation {
  position: relative;
  min-height: 100vh;
  padding: 50px 20px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at center, #fff6bd 0%, #ffe783 55%, #f7bd30 100%);
}

.content {
  position: relative;
  z-index: 2;
  max-width: 650px;
  margin: auto;
  padding: 35px 15px;
}

.bismillah {
  font-size: 35px;
  line-height: 1.8;
  margin-bottom: 10px;
}

.bismillah span {
  display: block;
  font-size: 17px;
  letter-spacing: 4px;
}

h1 {
  font-family: 'Great Vibes', cursive;
  font-size: clamp(60px, 12vw, 100px);
  font-weight: normal;
  margin: 25px 0 0;
  color: #bd7900;
}

h2 {
  font-size: clamp(36px, 8vw, 55px);
  font-weight: normal;
  letter-spacing: 8px;
  margin: 0 0 25px;
}

.intro {
  letter-spacing: 3px;
  line-height: 2;
  font-size: 14px;
}

.message {
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-size: 24px;
  line-height: 1.5;
  margin: 25px auto 35px;
}

.details {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 15px;
  margin: 35px 0;
}

.detail {
  flex: 1 1 120px;
  padding: 12px;
  border-right: 1px solid #d8a12d;
}

.detail:last-child {
  border-right: none;
}

.detail .symbol {
  font-size: 27px;
}

.detail h3 {
  font-size: 12px;
  font-weight: normal;
  letter-spacing: 3px;
}

.detail p {
  font-size: 18px;
  line-height: 1.5;
}

.map-button {
  display: inline-block;
  padding: 15px 30px;
  border-radius: 40px;
  background: #c88b05;
  color: white;
  text-decoration: none;
  letter-spacing: 1px;
  box-shadow: 0 6px 18px #c88b0540;
  transition: transform 0.3s;
}

.map-button:hover {
  transform: translateY(-3px);
}

.countdown-title {
  margin-top: 45px;
  letter-spacing: 5px;
}

.countdown {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin: 20px 0;
}

.time-box {
  width: 85px;
  height: 85px;
  border-radius: 50%;
  background: #fff4bd;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.time-box span {
  font-size: 26px;
}

.time-box small {
  font-size: 10px;
  letter-spacing: 1px;
  margin-top: 5px;
}

/* Sunflower decorations */
.flower {
  position: absolute;
  font-size: clamp(40px, 8vw, 85px);
  z-index: 1;
  animation: sway 4s ease-in-out infinite;
}

.flower.one {
  top: 10%;
  left: 2%;
}

.flower.two {
  top: 20%;
  right: 2%;
  animation-delay: 1s;
}

.flower.three {
  bottom: 5%;
  left: 2%;
  animation-delay: 2s;
}

.flower.four {
  bottom: 5%;
  right: 2%;
  animation-delay: 1.5s;
}

.leaf {
  position: absolute;
  font-size: 25px;
  animation: drift 7s ease-in-out infinite;
}

.leaf.one {
  top: 35%;
  left: 10%;
}

.leaf.two {
  top: 45%;
  right: 10%;
}

.leaf.three {
  bottom: 25%;
  left: 15%;
}

.leaf.four {
  bottom: 30%;
  right: 15%;
}

@keyframes sway {
  0%, 100% { transform: rotate(-5deg); }
  50% { transform: rotate(5deg); }
}

@keyframes drift {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-15px) rotate(15deg); }
}

/* Opening curtains */
.curtain {
  position: fixed;
  top: 0;
  width: 52%;
  height: 100vh;
  z-index: 10;
  background:
    repeating-linear-gradient(
      90deg,
      #d99b0c 0px,
      #ffda4e 20px,
      #f2bd24 40px,
      #ffe16a 60px
    );
  box-shadow: inset 0 0 45px #9d610b70;
  transition: transform 2s cubic-bezier(.77, 0, .18, 1);
}

.curtain.left {
  left: 0;
  border-right: 4px solid #e5ad25;
}

.curtain.right {
  right: 0;
  border-left: 4px solid #e5ad25;
}

.curtain::after {
  content: "🌻";
  position: absolute;
  top: 45%;
  font-size: 45px;
}

.curtain.left::after {
  right: 15px;
}

.curtain.right::after {
  left: 15px;
}

.curtain.open.left {
  transform: translateX(-100%);
}

.curtain.open.right {
  transform: translateX(100%);
}

.open-screen {
  position: fixed;
  inset: 0;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f9d450;
  color: #80500b;
  transition: opacity 0.5s;
}

.open-screen h2 {
  font-family: 'Great Vibes', cursive;
  font-size: 58px;
  letter-spacing: 0;
  margin: 10px;
}

.open-screen p {
  letter-spacing: 2px;
  margin: 10px 20px 25px;
}

.open-button {
  border: 1px solid #a66a08;
  border-radius: 40px;
  background: #a66a08;
  color: white;
  padding: 16px 32px;
  font: inherit;
  letter-spacing: 1px;
  cursor: pointer;
}

.open-screen.hidden {
  opacity: 0;
  pointer-events: none;
}

.music-button {
  position: fixed;
  bottom: 15px;
  right: 15px;
  z-index: 5;
  background: #a66a08;
  color: white;
  border: none;
  border-radius: 50%;
  width: 48px;
  height: 48px;
  font-size: 21px;
  cursor: pointer;
}

@media (max-width: 480px) {
  .invitation {
    padding: 25px 10px;
  }

  .content {
    padding: 25px 8px;
  }

  .detail {
    flex-basis: 95px;
    padding: 8px 4px;
  }

  .flower.one { left: 0; }
  .flower.two { right: 0; }
}
</style>
</head>

<body>

<div class="open-screen" id="openScreen">
  <div style="font-size:55px;">🌻</div>
  <h2>Zoya's Haldi</h2>
  <p>A little sunshine, love and celebration...</p>
  <button class="open-button" onclick="openInvitation()">
    Open Your Invitation ✨
  </button>
</div>

<div class="curtain left" id="leftCurtain"></div>
<div class="curtain right" id="rightCurtain"></div>

<main class="invitation">

  <div class="flower one">🌻</div>
  <div class="flower two">🌻</div>
  <div class="flower three">🌻</div>
  <div class="flower four">🌻</div>

  <div class="leaf one">🍃</div>
  <div class="leaf two">🍃</div>
  <div class="leaf three">🍃</div>
  <div class="leaf four">🍃</div>

  <section class="content">

    <div class="bismillah">
      بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
      <span>Bismillah</span>
    </div>

    <h1>Zoya's</h1>
    <h2>HALDI</h2>

    <p class="intro">
      YOU ARE WARMLY INVITED TO<br>
      CELEBRATE ZOYA'S HALDI
    </p>

    <p class="message">
      Let's come together to shower<br>
      her with love, laughter and<br>
      a whole lot of haldi!
    </p>

    <div class="details">

      <div class="detail">
        <div class="symbol">🗓️</div>
        <h3>DATE</h3>
        <p>13th December<br>Sunday</p>
      </div>

      <div class="detail">
        <div class="symbol">🕗</div>
        <h3>TIME</h3>
        <p>8:00 PM</p>
      </div>

      <div class="detail">
        <div class="symbol">📍</div>
        <h3>VENUE</h3>
        <p>Jalsa</p>
      </div>

    </div>

    <a
      class="map-button"
      href="https://maps.app.goo.gl/uqkNKR5VABf3qSbr5"
      target="_blank"
      rel="noopener noreferrer">
      📍 View on Google Maps →
    </a>

    <h3 class="countdown-title">COUNTDOWN</h3>

    <div class="countdown">
      <div class="time-box">
        <span id="days">00</span>
        <small>DAYS</small>
      </div>

      <div class="time-box">
        <span id="hours">00</span>
        <small>HOURS</small>
      </div>

      <div class="time-box">
        <span id="minutes">00</span>
        <small>MINUTES</small>
      </div>

      <div class="time-box">
        <span id="seconds">00</span>
        <small>SECONDS</small>
      </div>
    </div>

    <p class="message">With love, we can't wait to celebrate with you! 💛</p>

  </section>
</main>

<!-- Add your own licensed music file named haldi-music.mp3
     to the same folder as this HTML file. -->
<audio id="bgMusic" loop>
  <source src="haldi-music.mp3" type="audio/mpeg">
</audio>

<button
  class="music-button"
  id="musicButton"
  onclick="toggleMusic()"
  aria-label="Toggle background music">
  ♫
</button>

<script>
function openInvitation() {
  const music = document.getElementById("bgMusic");

  document.getElementById("leftCurtain").classList.add("open");
  document.getElementById("rightCurtain").classList.add("open");
  document.getElementById("openScreen").classList.add("hidden");

  music.play().then(() => {
    document.getElementById("musicButton").textContent = "♫";
  }).catch(() => {
    document.getElementById("musicButton").textContent = "▶";
  });
}

function toggleMusic() {
  const music = document.getElementById("bgMusic");
  const button = document.getElementById("musicButton");

  if (music.paused) {
    music.play().then(() => {
      button.textContent = "♫";
    }).catch(() => {
      button.textContent = "▶";
    });
  } else {
    music.pause();
    button.textContent = "▶";
  }
}

function updateCountdown() {
  // India Standard Time is UTC+05:30.
  const target = new Date("2026-12-13T20:00:00+05:30").getTime();
  const now = Date.now();
  const difference = target - now;

  if (difference <= 0) {
    document.getElementById("days").textContent = "00";
    document.getElementById("hours").textContent = "00";
    document.getElementById("minutes").textContent = "00";
    document.getElementById("seconds").textContent = "00";
    document.querySelector(".countdown-title").textContent = "THE CELEBRATION IS HERE! 🌻";
    return;
  }

  document.getElementById("days").textContent =
    String(Math.floor(difference / (1000 * 60 * 60 * 24))).padStart(2, "0");

  document.getElementById("hours").textContent =
    String(Math.floor((difference / (1000 * 60 * 60)) % 24)).padStart(2, "0");

  document.getElementById("minutes").textContent =
    String(Math.floor((difference / (1000 * 60)) % 60)).padStart(2, "0");

  document.getElementById("seconds").textContent =
    String(Math.floor((difference / 1000) % 60)).padStart(2, "0");
}

updateCountdown();
setInterval(updateCountdown, 1000);
</script>

</body>
</html>
