
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zoya's Haldi 🌻</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Georgia, serif;
  background: #ffdf45;
  color: #754313;
  overflow-x: hidden;
}

#curtain-screen {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffdf45;
  overflow: hidden;
}

.curtain {
  position: absolute;
  top: 0;
  height: 100%;
  width: 51%;
  background:
    repeating-linear-gradient(
      90deg,
      #c87920 0px,
      #e9a53c 25px,
      #f4bd59 50px,
      #b96b1d 75px
    );
  box-shadow: inset 0 0 30px #85430b;
  transition: transform 2s ease-in-out;
}

.curtain.left {
  left: 0;
  border-right: 5px solid #ffe6a0;
}

.curtain.right {
  right: 0;
  border-left: 5px solid #ffe6a0;
}

#curtain-screen.open .left {
  transform: translateX(-100%);
}

#curtain-screen.open .right {
  transform: translateX(100%);
}

.open-content {
  z-index: 2;
  text-align: center;
  padding: 24px;
  color: #fff7cf;
  text-shadow: 1px 2px 5px #703707;
}

.open-content h1 {
  font-size: clamp(2rem, 7vw, 3.5rem);
  margin: 20px 0;
}

.open-content p {
  font-size: 1.1rem;
  margin-bottom: 25px;
}

button {
  border: 2px solid #fff0b0;
  border-radius: 40px;
  background: #fff0b0;
  color: #79420e;
  padding: 14px 28px;
  font-size: 1rem;
  cursor: pointer;
  font-family: inherit;
  transition: .3s;
}

button:hover {
  background: #ffffff;
  transform: scale(1.04);
}

#curtain-screen.open .open-content {
  opacity: 0;
  transition: opacity .4s;
}

#invitation {
  min-height: 100vh;
  display: none;
  position: relative;
  overflow: hidden;
  padding: 35px 16px;
  background:
    radial-gradient(ellipse at center, #fff4a7 0%, #ffe56b 55%, #ffce35 100%);
}

#invitation::before,
#invitation::after {
  content: "🌻 🌼 🌻 🌼 🌻";
  position: absolute;
  left: 0;
  width: 100%;
  text-align: center;
  font-size: clamp(1.1rem, 4vw, 2rem);
  letter-spacing: 8px;
  pointer-events: none;
}

#invitation::before {
  top: 10px;
}

#invitation::after {
  bottom: 10px;
}

.sunflower {
  position: absolute;
  font-size: clamp(2rem, 7vw, 4rem);
  animation: sway 4s ease-in-out infinite;
}

.flower1 { top: 15%; left: 4%; }
.flower2 { top: 25%; right: 5%; animation-delay: 1s; }
.flower3 { bottom: 17%; left: 5%; animation-delay: 2s; }
.flower4 { bottom: 23%; right: 4%; animation-delay: .5s; }

@keyframes sway {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.card {
  position: relative;
  z-index: 1;
  max-width: 650px;
  margin: 35px auto;
  padding: clamp(25px, 6vw, 55px) 22px;
  text-align: center;
  background: rgba(255, 250, 220, .86);
  border: 3px double #c58b27;
  border-radius: 260px 260px 20px 20px;
  box-shadow: 0 12px 35px #ad761f35;
}

.bismillah {
  font-size: clamp(1.6rem, 5vw, 2.5rem);
  line-height: 1.8;
  color: #946017;
  margin-bottom: 10px;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 5px;
  font-size: .8rem;
  margin: 15px 0;
}

h1 {
  font-size: clamp(2.7rem, 9vw, 5rem);
  color: #b66b19;
  line-height: 1.1;
  margin: 18px 0;
}

.subtitle {
  font-size: 1.1rem;
  font-style: italic;
  line-height: 1.8;
}

.divider {
  color: #c28b2d;
  font-size: 1.8rem;
  margin: 18px 0;
}

.details {
  margin: 22px 0;
  line-height: 2;
  font-size: 1.1rem;
}

.details strong {
  color: #a55c14;
  font-size: 1.3rem;
}

.countdown {
  display: flex;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
  margin: 25px 0;
}

.time-box {
  background: #ffdf76;
  border: 1px solid #d9a03d;
  border-radius: 12px;
  padding: 12px 10px;
  min-width: 67px;
}

.time-box span {
  display: block;
  font-size: 1.6rem;
  font-weight: bold;
}

.time-box small {
  font-size: .7rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.map-button {
  display: inline-block;
  margin: 12px 0;
  text-decoration: none;
  border-radius: 40px;
  background: #a96318;
  color: white;
  padding: 13px 24px;
}

.music-button {
  margin-top: 10px;
  background: #f8d46a;
  border-color: #d5a33d;
}

.footer {
  font-style: italic;
  margin-top: 25px;
  line-height: 1.8;
}

@media (max-width: 480px) {
  #invitation { padding: 25px 10px; }
  .card { margin: 35px auto; }
  .flower1 { left: 0; }
  .flower2 { right: 0; }
}
</style>
</head>

<body>

<div id="curtain-screen">
  <div class="curtain left"></div>
  <div class="curtain right"></div>

  <div class="open-content">
    <div style="font-size:3rem;">🌻</div>
    <p>A little sunshine, a lot of love</p>
    <h1>Zoya's Haldi</h1>
    <button onclick="openInvitation()">Open Invitation ✨</button>
  </div>
</div>

<main id="invitation">
  <span class="sunflower flower1">🌻</span>
  <span class="sunflower flower2">🌼</span>
  <span class="sunflower flower3">🌼</span>
  <span class="sunflower flower4">🌻</span>

  <section class="card">
    <div class="bismillah" lang="ar" dir="rtl">
      بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ
    </div>

    <p class="eyebrow">With love and gratitude</p>

    <div class="divider">❋ ✦ ❋</div>

    <p class="subtitle">
      With hearts full of happiness,<br>
      we invite you to celebrate
    </p>

    <h1>Zoya's<br>Haldi</h1>

    <div class="divider">🌻 ❋ 🌻</div>

    <p class="subtitle">
      A day filled with sunshine,<br>
      laughter, love and blessings.
    </p>

    <div class="details">
      <p><strong>Sunday, 13 December 2026</strong></p>
      <p>At 8:00 PM</p>
      <p>📍 Jalsa</p>

      <a
        class="map-button"
        href="https://maps.app.goo.gl/uqkNKR5VABf3qSbr5"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open Google Maps ↗
      </a>
    </div>

    <div class="divider">❋ ✦ ❋</div>

    <p class="eyebrow">The celebration begins in</p>

    <div class="countdown" id="countdown">
      <div class="time-box"><span id="days">00</span><small>Days</small></div>
      <div class="time-box"><span id="hours">00</span><small>Hours</small></div>
      <div class="time-box"><span id="minutes">00</span><small>Minutes</small></div>
      <div class="time-box"><span id="seconds">00</span><small>Seconds</small></div>
    </div>

    <button class="music-button" id="musicToggle" onclick="toggleMusic()">
      🎵 Pause Music
    </button>

    <p class="footer">
      Your presence will make our celebration<br>
      even more special. 💛
      <br><br>
      With love,<br>
      <strong>Zoya & Family</strong>
    </p>
  </section>
</main>

<script>
let audioContext;
let musicTimer;
let musicPlaying = false;
let noteIndex = 0;

// A gentle original melody generated by the browser.
// No separate audio file is required.
const melody = [
  523.25, 659.25, 783.99, 659.25,
  587.33, 698.46, 880.00, 698.46,
  523.25, 659.25, 783.99, 1046.50,
  880.00, 783.99, 659.25, 587.33
];

function playNote() {
  if (!musicPlaying || !audioContext) return;

  const frequency = melody[noteIndex % melody.length];
  noteIndex++;

  const oscillator = audioContext.createOscillator();
  const gain = audioContext.createGain();

  oscillator.type = "sine";
  oscillator.frequency.value = frequency;

  gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
  gain.gain.exponentialRampToValueAtTime(
    0.07, audioContext.currentTime + 0.08
  );
  gain.gain.exponentialRampToValueAtTime(
    0.0001, audioContext.currentTime + 0.65
  );

  oscillator.connect(gain);
  gain.connect(audioContext.destination);

  oscillator.start();
  oscillator.stop(audioContext.currentTime + 0.7);
}

function startMusic() {
  if (!audioContext) {
    audioContext = new (
      window.AudioContext || window.webkitAudioContext
    )();
  }

  audioContext.resume();
  musicPlaying = true;
  playNote();

  musicTimer = setInterval(playNote, 700);
  document.getElementById("musicToggle").textContent = "🎵 Pause Music";
}

function stopMusic() {
  musicPlaying = false;
  clearInterval(musicTimer);
  document.getElementById("musicToggle").textContent = "🎵 Play Music";
}

function toggleMusic() {
  if (musicPlaying) {
    stopMusic();
  } else {
    startMusic();
  }
}

function openInvitation() {
  const curtain = document.getElementById("curtain-screen");
  curtain.classList.add("open");

  // User interaction permits the browser to start audio.
  startMusic();

  setTimeout(() => {
    curtain.style.display = "none";
    document.getElementById("invitation").style.display = "block";
    window.scrollTo(0, 0);
  }, 1900);
}

function updateCountdown() {
  // 8 PM India time, 13 December 2026
  const target = new Date("2026-12-13T20:00:00+05:30").getTime();
  const now = Date.now();
  const difference = target - now;

  if (difference <= 0) {
    document.getElementById("countdown").innerHTML =
      "<p>It's Haldi time! 🌻💛</p>";
    return;
  }

  document.getElementById("days").textContent =
    String(Math.floor(difference / (1000 * 60 * 60 * 24))).padStart(2, "0");

  document.getElementById("hours").textContent =
    String(Math.floor((difference / (1000 * 60 * 60)) % 24)).padStart(2, "0");

  document.getElementById("minutes").textContent =
    String(Math.floor((difference / (1000 * 60)) % 60)).padStart(2, "0");

  document.getElementById("seconds").textContent =
    String(Math.floor((difference / 1000) % 60)).padStart(2, "0");
}

updateCountdown();
setInterval(updateCountdown, 1000);
</script>

</body>
</html>
